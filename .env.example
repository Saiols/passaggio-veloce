# ============================================================
# Passaggio Veloce - Variabili d'ambiente
# Copia questo file in .env.local e compila i valori reali.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/passaggio_veloce?schema=public"

# --- Auth ---
AUTH_SECRET="" # Genera con: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@passaggioveloce.it"

# --- Storage (S3 / R2) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="passaggio-veloce-documenti"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Google Document AI ---
GOOGLE_PROJECT_ID=""
GOOGLE_DOCUMENT_AI_LOCATION="eu"
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Sentry ---
SENTRY_DSN=""

# --- Misc ---
NODE_ENV="development"
