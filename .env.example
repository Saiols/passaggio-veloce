# ============================================================
# Passaggio Veloce - Variabili d'ambiente
# Copia questo file in .env.local e compila i valori reali.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://pv:pv_dev_password@127.0.0.1:5432/passaggio_veloce?schema=public"

# --- Auth ---
AUTH_SECRET="" # Genera con: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@passaggioveloce.it"

# --- Storage (S3 / R2) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="passaggio-veloce-documenti"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- OCR ---
# OCR provider: mock (dev), mindee (prod-test Fase 1), google_documentai (prod Fase 2)
OCR_PROVIDER=mock

# Mindee V2 SDK — European Vehicle Registration (pre-trained model).
# Richiesto se OCR_PROVIDER=mindee.
# Setup: https://platform.mindee.com → Libraries → European Vehicle Registration.
# MINDEE_API_KEY: generata in Account Settings → API Keys.
# MINDEE_MODEL_ID: UUID del modello pre-trained, visibile nel tab "Documentation" del modello
#   (es. 3788acbb-63ba-4554-b7d0-b1937e14eb14 per EU Vehicle Registration).
#   Non è necessario fare training: il modello è già addestrato da Mindee su documenti EU.
MINDEE_API_KEY=""
MINDEE_MODEL_ID=""

# --- Google Document AI ---
GOOGLE_PROJECT_ID=""
GOOGLE_DOCUMENT_AI_LOCATION="eu"
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Sentry ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Cron ---
# Secret per autenticare chiamate Vercel Cron ai /api/jobs/*.
# Vercel imposta automaticamente l'header `Authorization: Bearer <CRON_SECRET>`.
# In dev può essere lasciato vuoto: i job sono comunque richiamabili da admin
# autenticato via /admin/demo-control.
CRON_SECRET=""

# --- Misc ---
NODE_ENV="development"
