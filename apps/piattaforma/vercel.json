{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/jobs/distribuzione-tick",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/jobs/send-solleciti",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/jobs/process-fee-scheduled",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/jobs/process-payouts",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/jobs/trigger-auto-payout",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/jobs/crm-sync",
      "schedule": "0 2 * * *"
    }
  ]
}
