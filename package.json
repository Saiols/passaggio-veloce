{
  "name": "passaggio-veloce",
  "version": "0.0.1",
  "private": true,
  "description": "Passaggio Veloce - SaaS B2B per passaggi di proprieta veicoli in Italia",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pv/db db:migrate",
    "db:generate": "pnpm --filter @pv/db db:generate",
    "db:studio": "pnpm --filter @pv/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
