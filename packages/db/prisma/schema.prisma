// Passaggio Veloce - Prisma schema
// Schema esteso Fase 2: auth, multi-utente, inviti, verification token.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum CompanyType {
  DEALER
  AGENZIA
}

enum UserRole {
  ADMIN_AZIENDA
  UTENTE_AZIENDA
  ADMIN_PIATTAFORMA
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ============================================================
// MODELS
// ============================================================

model Company {
  id              String      @id @default(uuid()) @db.Uuid
  type            CompanyType

  ragioneSociale  String
  partitaIva      String      @unique
  codiceSdi       String?
  pec             String
  email           String
  telefono        String?

  indirizzo       String
  citta           String
  cap             String
  provincia       String

  iban            String?
  sepaMandateAccepted   Boolean   @default(false)
  sepaMandateAcceptedAt DateTime?

  termsAcceptedAt DateTime?

  users           User[]
  invitations     Invitation[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([type])
  @@index([citta])
  @@map("companies")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  emailVerifiedAt DateTime?

  nome            String
  cognome         String
  codiceFiscale   String?
  dataNascita     DateTime?
  luogoNascita    String?

  role            UserRole   @default(UTENTE_AZIENDA)
  status          UserStatus @default(PENDING_EMAIL_VERIFICATION)

  companyId       String?    @db.Uuid
  company         Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)

  lastLoginAt     DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  @@index([companyId])
  @@index([status])
  @@map("users")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  token     String                @unique
  type      VerificationTokenType
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([email, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Invitation {
  id        String           @id @default(uuid()) @db.Uuid
  email     String
  token     String           @unique
  role      UserRole         @default(UTENTE_AZIENDA)
  status    InvitationStatus @default(PENDING)

  companyId String           @db.Uuid
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invitedById String         @db.Uuid

  expiresAt DateTime
  acceptedAt DateTime?

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}
