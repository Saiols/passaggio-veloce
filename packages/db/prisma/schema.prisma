// ============================================================
// MODELS — identità
// ============================================================

model Company {
  id   String      @id @default(uuid()) @db.Uuid
  type CompanyType

  ragioneSociale String
  partitaIva     String  @unique
  codiceSdi      String?
  pec            String
  email          String
  telefono       String?

  indirizzo String
  civico    String?
  citta     String
  cap       String
  provincia String

  iban                  String?
  sepaMandateAccepted   Boolean   @default(false)
  sepaMandateAcceptedAt DateTime?

  /// Stripe Customer dell'agenzia (null per dealer/broker).
  stripeCustomerId String?

  /// PaymentMethod sepa_debit salvato, usato per gli addebiti off_session.
  stripePaymentMethodId String?

  /// Id del mandato SEPA Stripe (audit legale / dichiarazioni).
  sepaMandateId String?

  /// Stato del mandato SEPA. PENDING finché Stripe non conferma,
  /// ACTIVE quando utilizzabile per addebiti, FAILED se il setup fallisce.
  sepaMandateStatus SepaMandateStatus @default(PENDING)

  termsAcceptedAt DateTime?

  /// AF-AC: IP di signup (truncato 3 ottetti) — usato per il check
  /// anti-collusione "stesso IP signup tra referente e referral".
  signupIp String?

  // Attribuzione marketing UTM (first-touch, catturati alla landing)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  // F-01: sospensione temporanea (riattivabile). Diversa da deletedAt (totale).
  // null = ACTIVE; valorizzato = SUSPENDED.
  suspendedAt DateTime?

  /// A7: ultima nota admin sull'azione di sospensione/riattivazione.
  /// Audit semplificato: una sola nota, sovrascritta ad ogni transizione.
  suspensionLastNote String?

  /// Blocco "soft" per addebito fee non riuscito: l'agenzia può ancora fare
  /// login ma è confinata a /blocco-pagamento finché l'addebito non riesce.
  /// Distinto da suspendedAt (sospensione admin che impedisce il login).
  bloccoPagamentoAt     DateTime?
  bloccoPagamentoMotivo String?

  // FASE 13 affiliazione: chi ha portato questa Company in piattaforma.
  // null = iscritto diretto. Auto-relazione (può puntare a broker o agenzia).
  referenteId String?   @db.Uuid
  referente   Company?  @relation("Referrals", fields: [referenteId], references: [id])
  referrals   Company[] @relation("Referrals")

  // Codice referral univoco da inserire nel link di iscrizione.
  // Nullable durante backfill, dopo migration tutti i record avranno valore.
  // DEPRECATO con multi-sede: la sorgente primaria è Sede.referralCode; questo
  // resta in sola lettura per risolvere vecchi link /r/<code>.
  referralCode String? @unique

  // Multi-sede: unità operative sotto questa madre.
  sedi Sede[] @relation("CompanySedi")

  // Affiliazione: la sede (della madre referente) che ha condiviso il link.
  // referenteId resta e punta SEMPRE a una madre (affiliazione madre→madre).
  referenteSedeId String? @db.Uuid
  referenteSede   Sede?   @relation("SedeReferral", fields: [referenteSedeId], references: [id])

  users       User[]
  invitations Invitation[]

  // Pratiche (broker)
  praticheCreate    Pratica[]             @relation("PraticheBroker")
  // Pratiche (agenzia assegnata)
  praticheAssegnate Pratica[]             @relation("PraticheAgenziaAssegnata")
  // Assegnazioni intermedie (round 1/2/3)
  assegnazioni      PraticaAssegnazione[]
  // Documenti anagrafici aziendali (visura, CI amministratore)
  documenti         Documento[]           @relation("DocumentiCompany")

  // Calendario agenzia
  orariApertura         OrariApertura[]
  chiusureStraordinarie ChiusuraStraordinaria[]

  // Wallet (broker)
  wallet Wallet?

  // Fee (agenzia)
  feeAddebiti FeeAddebito[]

  // Mandato Fatturazione (firma OTP primo payout)
  mandatoFatturazione MandatoFatturazione?

  // Valutazioni (agenzia che riceve / dealer che vota)
  valutazioniRicevute Valutazione[] @relation("ValutazioniAgenzia")
  valutazioniFatte    Valutazione[] @relation("ValutazioniDealer")

  // Commissioni affiliazione (questa company è referente di altri — FASE 13)
  commissioniGenerate CommissioneAffiliazione[] @relation("ReferenteCommissioni")
  // Click tracking sul referralCode di questa company
  referralClicks      ReferralClick[]           @relation("ReferralClicks")

  // CRM lead pipeline match (release CRM-A): contatti CRM agganciati a
  // questa company via webhook iscrizione (cascata email→tel→P.IVA).
  crmContactMatches CrmContact[] @relation("CrmContactCompany")

  // Codici promozionali riscattati da questa azienda (in registrazione)
  promoRedemptions PromoCodeRedemption[]

  // Listini (agenzia)
  listini Listino[]

  // Notifiche
  notifiche NotificaInviata[]

  // Soglia payout automatico in centesimi (item 12 release 2026-05).
  // Default 1000 EUR (100000 cent), range applicativo 1000-5000 EUR.
  // Quando il saldo wallet la supera, parte il job payout automatico.
  payoutThresholdCent Int @default(100000)

  // KYC registrazione (step 3): data emissione della visura camerale caricata
  // in fase di iscrizione. Usata per validare il vincolo "max 6 mesi" e, in
  // futuro, per rilevare visure scadute lato admin.
  visuraCameraleData DateTime? @db.Date

  // Fatturazione (FT-A)
  regimeFiscale RegimeFiscale @default(ORDINARIO)
  // Numerazione paper: ID soggetto univoco a 4 cifre nel numero documento broker
  // (es. PV-0047-2026-00001). Postgres sequence: univoco, mai riassegnato.
  numeroSoggetto    Int                @unique @default(dbgenerated("nextval('numero_soggetto_seq')"))
  documentiEmessi   DocumentoFiscale[] @relation("DocumentiEmessi")
  documentiRicevuti DocumentoFiscale[] @relation("DocumentiRicevuti")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([citta])
  @@index([provincia])
  @@map("companies")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  // Multi-tenancy email scope-company (item 07 release 2026-05): la stessa
  // email puo' esistere in piu' aziende (es. consulente esterno). Unique
  // compound (companyId, email). Per gli admin platform (companyId=null)
  // un partial index garantisce comunque l'unicita' tra di loro: vedi
  // migration team_email_per_company.
  email           String
  passwordHash    String
  emailVerifiedAt DateTime?

  nome          String
  cognome       String
  codiceFiscale String?
  dataNascita   DateTime?
  luogoNascita  String?

  role   UserRole   @default(UTENTE_AZIENDA)
  status UserStatus @default(PENDING_EMAIL_VERIFICATION)

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  lastLoginAt DateTime?

  /// A9: TOTP 2FA. Se enabled=true, dopo password serve anche il codice TOTP.
  /// twoFactorSecret è il secret base32 condiviso con l'app authenticator.
  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  /// 10 backup codes hashati (bcrypt). Array JSON di stringhe.
  /// Ogni codice consumato viene rimosso dall'array.
  twoFactorBackupCodes   Json?

  /// Preferenze notifiche opzionali: mappa { "<NotificaTipo>": boolean }. Default opt-in (assenza = true).
  notifPrefs Json?
  /// Token per unsubscribe one-click via link email (generato lazy al primo invio opzionale).
  unsubscribeToken String? @unique

  // Documenti caricati da questo utente
  documentiCaricati Documento[] @relation("DocumentiUploader")

  // Notifiche dirette all'utente
  notifiche NotificaInviata[]

  // Dichiarazioni di responsabilità accettate (Sistema Penali Broker)
  dichiarazioni BrokerDichiarazione[]

  // CRM team interno (release CRM-A)
  crmContactsAssegnati CrmContact[]  @relation("CrmContactAssigned")
  crmCampagneOwned     CrmCampaign[] @relation("CrmCampaignOwner")

  // AF-AC: review commissioni affiliazione sospette
  commissioniReviewed CommissioneAffiliazione[] @relation("CommissioneAffiliazioneReviewer")

  // Tariffario piattaforma: righe create da questo utente (admin)
  tariffeCreate TariffaPiattaforma[] @relation("TariffaCreatedBy")

  // Multi-sede: sedi su cui questo utente può operare (login multi-sede).
  sediMembership UserSede[]

  // Mandati fatturazione firmati (firma OTP primo payout)
  mandatiFirmati MandatoFatturazione[] @relation("MandatiFirmati")

  // OTP email per firma mandato fatturazione (ephemeral, hashato)
  mandatoOtpHash      String?
  mandatoOtpExpiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, email])
  @@index([companyId])
  @@index([status])
  @@index([email])
  @@map("users")
}

// ============================================================
// MODELS — multi-sede (azienda madre → N sedi operative)
// Spec: docs/sistema-multi-sede.md
// ============================================================

// Unità operativa senza P.IVA propria. Appartiene a una Company (madre,
// soggetto giuridico). Eredita `type` dalla madre (single-type). I sottosistemi
// operativi (pratiche, assegnazione, calendario, wallet, valutazioni, referral)
// si agganciano alla Sede; fatturazione/SEPA/KYC restano sulla Company.
model Sede {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @db.Uuid
  company   Company     @relation("CompanySedi", fields: [companyId], references: [id], onDelete: Cascade)
  type      CompanyType

  nome      String
  indirizzo String
  civico    String?
  citta     String
  cap       String
  provincia String
  telefono  String?
  email     String?

  iban                String? // null → usa Company.iban (madre)
  payoutThresholdCent Int     @default(100000)
  referralCode        String? @unique
  codiceInterno       String?

  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  praticheBroker        Pratica[]                 @relation("PraticheBrokerSede")
  praticheAgenzia       Pratica[]                 @relation("PraticheAgenziaSede")
  assegnazioni          PraticaAssegnazione[]
  orariApertura         OrariApertura[]
  chiusureStraordinarie ChiusuraStraordinaria[]
  listini               Listino[]
  valutazioniRicevute   Valutazione[]             @relation("ValutazioniAgenziaSede")
  valutazioniFatte      Valutazione[]             @relation("ValutazioniBrokerSede")
  wallet                Wallet?                   @relation("WalletSede")
  feeAddebiti           FeeAddebito[]
  referralClicks        ReferralClick[]
  membership            UserSede[]
  eventi                EventoPratica[]
  notifiche             NotificaInviata[]
  commissioniAttribuite CommissioneAffiliazione[] @relation("SedeAffiliante")
  companiesAffiliate    Company[]                 @relation("SedeReferral")

  @@index([companyId])
  @@index([type])
  @@index([citta])
  @@index([provincia])
  @@map("sedi")
}

// Membership molti-a-molti utente↔sede (login multi-sede). Il `ruolo` distingue
// l'admin di sede (gestisce utenti/impostazioni della sede) dall'operatore.
model UserSede {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @db.Uuid
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sedeId String    @db.Uuid
  sede   Sede      @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  ruolo  RuoloSede @default(OPERATORE)

  createdAt DateTime @default(now())

  @@unique([userId, sedeId])
  @@index([sedeId])
  @@index([userId])
  @@map("user_sedi")
}

// (Vedi modello Company per payoutThresholdCent: soglia payout automatico
// configurabile per utente - item 12 release 2026-05.)

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  token     String                @unique
  type      VerificationTokenType
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([email, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Invitation {
  id     String           @id @default(uuid()) @db.Uuid
  email  String
  token  String           @unique
  role   UserRole         @default(UTENTE_AZIENDA)
  status InvitationStatus @default(PENDING)

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Multi-sede: sede di destinazione dell'invito (null = invito a livello madre,
  // solo per ADMIN_AZIENDA) + ruolo dell'utente nella sede.
  sedeId    String?   @db.Uuid
  ruoloSede RuoloSede @default(OPERATORE)

  invitedById String @db.Uuid

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

// ============================================================
// MODELS — pratiche
// ============================================================

model Pratica {
  id            String  @id @default(uuid()) @db.Uuid
  // Codice leggibile es. PV-2026-04821, generato al submit (NON in bozza)
  codicePratica String? @unique

  tipo  PraticaTipo
  stato PraticaStato @default(BOZZA)

  // Numero veicoli: 1 per SEMPLICE, ≥ 2 per MINIVOLTURA.
  numeroVeicoli Int @default(1)

  // Dati venditore: ora normalizzati in modello Venditore (co-intestatari, N
  // per pratica). Vedi relation `venditori` sotto.

  // Dati acquirente
  acquirenteNome               String?
  acquirenteCognome            String?
  acquirenteCF                 String?
  acquirenteIsPersonaGiuridica Boolean @default(false)
  acquirenteRagioneSociale     String?
  acquirentePIVA               String?
  acquirenteTelefono           String?
  acquirenteEmail              String?
  acquirenteIndirizzoResidenza String? // null = stesso del documento; valorizzato = residenza diversa

  // Flag pratica
  flagCointestazione Boolean @default(false)
  flagMinivoltura    Boolean @default(false)
  flagProcura        Boolean @default(false)

  // Schema Documentale v7 (SD-A release 2026-05): variabili dell'albero
  // decisionale documenti. Compilate dal broker durante il wizard branching,
  // determinano la lista di documenti richiesti tramite engine puro.
  // venditoreTipoSoggetto/VisuraData/PermessoData spostati in modello Venditore.
  acquirenteTipoSoggetto TipoSoggetto?
  acquirenteCiTipo       CiTipo?
  acquirenteVisuraData   DateTime?     @db.Date
  acquirentePermessoData DateTime?     @db.Date
  flagSuccessione        Boolean       @default(false)
  flagMinore             Boolean       @default(false)

  // Caso non riconosciuto / dubbio: pratica resta BOZZA, team PV verifica
  // entro 24-48h. Niente nuovo PraticaStato per evitare branch nel workflow.
  richiedeRevisioneManuale Boolean                 @default(false)
  motivoRevisione          MotivoRevisioneManuale?
  noteRevisione            String?
  revisioneCompletata      Boolean                 @default(false)
  revisioneCompletataAt    DateTime?
  revisioneCompletataDaId  String?                 @db.Uuid

  // Localizzazione / distribuzione
  comune    String?
  provincia String?

  // Attori (Company madre — legacy, mantenuti in fase expand)
  brokerId String  @db.Uuid
  broker   Company @relation("PraticheBroker", fields: [brokerId], references: [id])

  agenziaAssegnataId String?  @db.Uuid
  agenziaAssegnata   Company? @relation("PraticheAgenziaAssegnata", fields: [agenziaAssegnataId], references: [id])

  // Multi-sede: sede operativa broker / sede agenzia assegnata.
  brokerSedeId  String? @db.Uuid
  brokerSede    Sede?   @relation("PraticheBrokerSede", fields: [brokerSedeId], references: [id])
  agenziaSedeId String? @db.Uuid
  agenziaSede   Sede?   @relation("PraticheAgenziaSede", fields: [agenziaSedeId], references: [id])

  // Codice interno agenzia + nota (assegnata al momento accettazione)
  codiceAgenziaInterno String?
  notaInternaAgenzia   String?

  // Economics (in centesimi)
  feeAgenziaCent    Int @default(0)
  creditoBrokerCent Int @default(0)

  // Timeline
  submittedAt     DateTime?
  round1StartedAt DateTime?
  round2StartedAt DateTime?
  round3StartedAt DateTime?
  escalationAt    DateTime?
  accettataAt     DateTime?
  processataAt    DateTime?
  firmaAvvenutaAt DateTime?

  // Sistema Penali Broker (SP-A release 2026-05): segnalazione fermo/ipoteca
  // dall'agenzia, gestione admin, log penale addebitata.
  flagSegnalata         Boolean                   @default(false)
  tipoSegnalazione      SegnalazionePraticaTipo?
  notaSegnalazione      String?
  segnalataAt           DateTime?
  segnalataDaUserId     String?                   @db.Uuid
  segnalazioneStato     SegnalazionePraticaStato?
  segnalazioneEsitaAt   DateTime?
  segnalazioneEsitaDaId String?                   @db.Uuid
  // Importo penale addebitata al broker per questa pratica (audit). Null se
  // pratica non ha generato penale.
  penaleAddebitatoCent  Int?
  autoAddebitoAt        DateTime?
  scadutaAt             DateTime?
  annullataAt           DateTime?

  // Relations
  veicoli                 Veicolo[]
  venditori               Venditore[]
  coAcquirenti            CoAcquirente[]
  documenti               Documento[]
  assegnazioni            PraticaAssegnazione[]
  transazioni             TransazioneWallet[]
  feeAddebiti             FeeAddebito[]
  valutazione             Valutazione?
  documentiFiscali        DocumentoFiscale[]
  commissioniAffiliazione CommissioneAffiliazione[]
  dichiarazioniBroker     BrokerDichiarazione[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([brokerId])
  @@index([agenziaAssegnataId])
  @@index([brokerSedeId])
  @@index([agenziaSedeId])
  @@index([stato])
  @@index([provincia])
  @@index([comune])
  @@index([flagSegnalata])
  @@index([richiedeRevisioneManuale])
  @@map("pratiche")
}

// Log immutabile dell'accettazione del popup di responsabilità broker
// (Sistema Penali Broker — SP-A release 2026-05). Una riga per ogni submit
// di pratica: timestamp, IP anonimizzato, userId, versione del testo popup.
model BrokerDichiarazione {
  id String @id @default(uuid()) @db.Uuid

  praticaId String  @db.Uuid
  pratica   Pratica @relation(fields: [praticaId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  ip           String? // GDPR: IPv4 = primi 3 ottetti; IPv6 = primi 4 hextet
  userAgent    String?
  popupVersion String // "v1.0", "v1.1" — audit se il testo cambia

  createdAt DateTime @default(now())

  @@index([praticaId])
  @@index([userId])
  @@map("broker_dichiarazioni")
}

model PraticaAssegnazione {
  id String @id @default(uuid()) @db.Uuid

  praticaId String  @db.Uuid
  pratica   Pratica @relation(fields: [praticaId], references: [id], onDelete: Cascade)

  agenziaId String  @db.Uuid
  agenzia   Company @relation(fields: [agenziaId], references: [id])

  // Multi-sede: sede agenzia assegnataria (distribuzione a sede fisica).
  sedeId String? @db.Uuid
  sede   Sede?   @relation(fields: [sedeId], references: [id])

  round Int // 1, 2, 3

  invioAt           DateTime  @default(now())
  notificaInviataAt DateTime?

  // Countdown per-agenzia basato sui suoi orari di apertura
  countdownInizioAt DateTime?
  countdownFineAt   DateTime?

  esito       AssegnazioneEsito @default(PENDING)
  esitoAt     DateTime?
  notaRifiuto String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([praticaId, agenziaId, round])
  @@index([agenziaId, esito])
  @@index([sedeId, esito])
  @@index([round, esito])
  @@map("pratiche_assegnazioni")
}

// ============================================================
// MODELS — documenti
// ============================================================

model Documento {
  id String @id @default(uuid()) @db.Uuid

  tipo  DocumentoTipo
  owner DocumentoOwner? // a chi si riferisce (venditore/acquirente/...)

  // Proprietà: può essere su una pratica OPPURE anagrafica aziendale (visura)
  praticaId String?  @db.Uuid
  pratica   Pratica? @relation(fields: [praticaId], references: [id], onDelete: Cascade)

  companyId String?  @db.Uuid
  company   Company? @relation("DocumentiCompany", fields: [companyId], references: [id], onDelete: Cascade)

  // Veicolo specifico (es. libretto di circolazione di un veicolo della pratica)
  veicoloId String?  @db.Uuid
  veicolo   Veicolo? @relation("DocumentiVeicolo", fields: [veicoloId], references: [id], onDelete: SetNull)

  // Venditore specifico (co-intestatario): documenti identità/permesso per parte
  venditoreId String?    @db.Uuid
  venditore   Venditore? @relation("DocumentiVenditore", fields: [venditoreId], references: [id], onDelete: SetNull)

  // Co-intestatario acquirente: documenti identità/permesso per parte
  coAcquirenteId String?       @db.Uuid
  coAcquirente   CoAcquirente? @relation("DocumentiCoAcquirente", fields: [coAcquirenteId], references: [id], onDelete: SetNull)

  // Storage
  storageKey       String // path/key nel provider (locale o S3)
  storageProvider  String @default("local") // "local" | "s3" | "gcs"
  mimeType         String
  sizeBytes        Int
  originalFilename String

  uploadedById String @db.Uuid
  uploadedBy   User   @relation("DocumentiUploader", fields: [uploadedById], references: [id])

  // OCR
  ocrStato    OcrStato  @default(NONE)
  ocrProvider String? // "mock" | "google_documentai" | ...
  ocrData     Json?
  ocrAt       DateTime?
  ocrError    String?

  // Gating IA
  gatingStato        GatingStato @default(NONE)
  gatingError        String?
  gatingOverrideById String?     @db.Uuid
  gatingOverrideAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([praticaId])
  @@index([companyId])
  @@index([veicoloId])
  @@index([venditoreId])
  @@index([coAcquirenteId])
  @@index([tipo])
  @@index([gatingStato])
  @@map("documenti")
}

model Veicolo {
  id                   String    @id @default(uuid()) @db.Uuid
  praticaId            String    @db.Uuid
  pratica              Pratica   @relation(fields: [praticaId], references: [id], onDelete: Cascade)
  ordine               Int
  tipoDocumento        TipoDocumentoVeicolo @default(LIBRETTO)
  targa                String?
  telaio               String?
  proprietarioAttuale  String?
  dataImmatricolazione DateTime?
  preImm2015           Boolean   @default(false)
  flagComodatoDuso     Boolean   @default(false)
  flagDelegaVendita    Boolean   @default(false)
  prezzoVenditaCent    Int? // prezzo di vendita veicolo (cent); richiesto in creazione pratica
  ocrData              Json?
  ocrProvider          String?
  ocrAt                DateTime?
  documenti            Documento[] @relation("DocumentiVeicolo")
  venditori            Venditore[] @relation("VeicoloVenditori")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([praticaId])
  @@map("veicoli")
}

model Venditore {
  id                 String        @id @default(uuid()) @db.Uuid
  praticaId          String        @db.Uuid
  pratica            Pratica       @relation(fields: [praticaId], references: [id], onDelete: Cascade)
  veicoloId          String?       @db.Uuid
  veicolo            Veicolo?      @relation("VeicoloVenditori", fields: [veicoloId], references: [id], onDelete: SetNull)
  ordine             Int
  nome               String?
  cognome            String?
  cf                 String?
  isPersonaGiuridica Boolean       @default(false)
  ragioneSociale     String?
  piva               String?
  telefono           String?
  email              String?
  tipoSoggetto       TipoSoggetto?
  ciTipo             CiTipo?
  visuraData         DateTime?     @db.Date
  permessoData       DateTime?     @db.Date
  documentoIdentita  String?
  documenti          Documento[]   @relation("DocumentiVenditore")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([praticaId])
  @@index([veicoloId])
  @@map("venditori")
}

model CoAcquirente {
  id                 String        @id @default(uuid()) @db.Uuid
  praticaId          String        @db.Uuid
  pratica            Pratica       @relation(fields: [praticaId], references: [id], onDelete: Cascade)
  ordine             Int
  nome               String?
  cognome            String?
  cf                 String?
  isPersonaGiuridica Boolean       @default(false)
  ragioneSociale     String?
  piva               String?
  telefono           String?
  email              String?
  tipoSoggetto       TipoSoggetto?
  ciTipo             CiTipo?
  visuraData         DateTime?     @db.Date
  permessoData       DateTime?     @db.Date
  documentoIdentita  String?
  indirizzoResidenza String? // null = stesso del documento
  documenti          Documento[]   @relation("DocumentiCoAcquirente")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([praticaId])
  @@map("co_acquirenti")
}

// ============================================================
// MODELS — calendario agenzia
// ============================================================

model OrariApertura {
  id String @id @default(uuid()) @db.Uuid

  agenziaId String  @db.Uuid
  agenzia   Company @relation(fields: [agenziaId], references: [id], onDelete: Cascade)

  // Multi-sede: calendario per sede fisica.
  sedeId String? @db.Uuid
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  giorno GiornoSettimana

  // Fasce orarie come JSON: [{ inizio: "09:00", fine: "13:00" }, { inizio: "15:00", fine: "18:30" }]
  fasceOrarie Json

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([agenziaId, giorno])
  @@unique([sedeId, giorno])
  @@map("orari_apertura")
}

model ChiusuraStraordinaria {
  id String @id @default(uuid()) @db.Uuid

  agenziaId String  @db.Uuid
  agenzia   Company @relation(fields: [agenziaId], references: [id], onDelete: Cascade)

  // Multi-sede: chiusura per sede fisica.
  sedeId String? @db.Uuid
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  dataInizio DateTime @db.Date
  dataFine   DateTime @db.Date
  motivo     String?

  createdAt DateTime @default(now())

  @@index([agenziaId, dataInizio])
  @@map("chiusure_straordinarie")
}

// ============================================================
// MODELS — wallet e pagamenti
// ============================================================

model Wallet {
  id String @id @default(uuid()) @db.Uuid

  // Multi-sede: il wallet appartiene a una SEDE (crediti pratica broker) OPPURE
  // a una Company madre (commissioni affiliazione). Esattamente uno valorizzato.
  sedeId    String?  @unique @db.Uuid
  sede      Sede?    @relation("WalletSede", fields: [sedeId], references: [id], onDelete: Cascade)
  companyId String?  @unique @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  saldoCent Int @default(0)

  transazioni TransazioneWallet[]
  payouts     Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model TransazioneWallet {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  tipo          TransazioneWalletTipo
  importoCent   Int // positivo = credito, negativo = debito
  saldoPostCent Int // saldo dopo la transazione (audit)

  praticaId String?  @db.Uuid
  pratica   Pratica? @relation(fields: [praticaId], references: [id])

  payoutId String? @db.Uuid
  payout   Payout? @relation(fields: [payoutId], references: [id])

  // Eventuale commissione affiliazione associata (FASE 13)
  commissioneAffiliazione CommissioneAffiliazione?

  note String?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([praticaId])
  @@map("transazioni_wallet")
}

model Payout {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  importoCent Int
  stato       PayoutStato @default(RICHIESTO)
  automatico  Boolean     @default(false)

  richiestoAt  DateTime  @default(now())
  eseguitoAt   DateTime?
  fallitoAt    DateTime?
  errorMessage String?

  // Rendiconto PDF (ref Documento opzionale)
  rendicontoStorageKey String?
  providerRef          String? // riferimento Stripe Payout (post-integrazione)

  transazioni TransazioneWallet[]
  documentoFiscale DocumentoFiscale?

  @@index([walletId, stato])
  @@map("payouts")
}

model FeeAddebito {
  id String @id @default(uuid()) @db.Uuid

  praticaId String  @db.Uuid
  pratica   Pratica @relation(fields: [praticaId], references: [id], onDelete: Cascade)

  agenziaId String  @db.Uuid
  agenzia   Company @relation(fields: [agenziaId], references: [id])

  // Multi-sede: sede che ha generato la fee (attribuzione). L'addebito SEPA usa
  // comunque il mandato della Company madre.
  agenziaSedeId String? @db.Uuid
  agenziaSede   Sede?   @relation(fields: [agenziaSedeId], references: [id])

  importoCent Int
  tipo        FeeAddebitoTipo
  stato       FeeAddebitoStato @default(SCHEDULED)

  scheduledAt  DateTime?
  executedAt   DateTime?
  errorMessage String?
  providerRef  String? // riferimento Stripe charge (post-integrazione)

  /// Numero di tentativi di addebito (incrementato a ogni retry manuale).
  /// Entra nell'idempotency key Stripe per forzare un nuovo PaymentIntent.
  tentativi Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agenziaId, stato])
  @@index([agenziaSedeId, stato])
  @@index([praticaId])
  @@index([scheduledAt])
  @@map("fee_addebiti")
}

// ============================================================
// MODELS — mandato fatturazione (firma OTP primo payout)
// ============================================================

model MandatoFatturazione {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firmatarioUserId String @db.Uuid
  firmatario       User   @relation("MandatiFirmati", fields: [firmatarioUserId], references: [id], onDelete: Restrict)
  firmatoAt        DateTime @default(now())

  storageKey      String
  storageProvider String @default("local")
  mimeType        String @default("application/pdf")
  sizeBytes       Int

  datiSnapshot Json

  ip              String?
  userAgent       String?
  otpVerificatoAt DateTime

  createdAt DateTime @default(now())

  @@map("mandati_fatturazione")
}

// ============================================================
// ENUMS — affiliazione (scaffold FASE 13)
// ============================================================

enum CommissioneAffiliazioneTipo {
  REFERENTE_BROKER
  REFERENTE_AGENZIA
}

enum CommissioneAffiliazioneStato {
  MATURATA
  ACCREDITATA
  ANNULLATA
  /// Bloccata da check anti-collusione: in attesa di review admin (AF-AC).
  /// Non popola wallet finché un admin non la approva (→ ACCREDITATA).
  DA_REVISIONARE
}

// ============================================================
// MODELS — affiliazione (scaffold FASE 13)
// ============================================================

model ReferralClick {
  id String @id @default(uuid()) @db.Uuid

  // FK al referente la cui Company.referralCode ha generato il click.
  companyId String  @db.Uuid
  company   Company @relation("ReferralClicks", fields: [companyId], references: [id], onDelete: Cascade)

  // Multi-sede: la sede il cui referralCode ha generato il click.
  sedeId String? @db.Uuid
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  /// Snapshot del code (audit, anche se la company viene eliminata).
  referralCode String

  /// IP truncato (prime 3 ottetti per IPv4) per minimizzare i dati personali.
  ip        String?
  userAgent String?

  /// UTM tracking (opzionale, dipende da come l'utente ha condiviso il link).
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([referralCode])
  @@map("referral_clicks")
}

model CommissioneAffiliazione {
  id String @id @default(uuid()) @db.Uuid

  praticaId String  @db.Uuid
  pratica   Pratica @relation(fields: [praticaId], references: [id], onDelete: Cascade)

  // Chi riceve la commissione (Company referente = madre)
  referenteId String  @db.Uuid
  referente   Company @relation("ReferenteCommissioni", fields: [referenteId], references: [id])

  // Multi-sede: la sede della madre che ha affiliato (attribuzione/classifica).
  referenteSedeId String? @db.Uuid
  referenteSede   Sede?   @relation("SedeAffiliante", fields: [referenteSedeId], references: [id])

  tipo  CommissioneAffiliazioneTipo
  stato CommissioneAffiliazioneStato @default(MATURATA)

  // In centesimi: importoLordo = nostra spesa per quel referente,
  // importoNetto = quanto effettivamente accreditato.
  // Modello §1.2: invariante tra 1 e 2 referenti (in 2 referenti dimezziamo a testa).
  importoLordoCent Int
  importoNettoCent Int

  // Cap durata commissione (decisione D-04): null = sempre, valorizzato = scade.
  expiresAt DateTime?

  // Riferimento alla transazione wallet di accredito (popolato quando stato = ACCREDITATA).
  transazioneWalletId String?            @unique @db.Uuid
  transazioneWallet   TransazioneWallet? @relation(fields: [transazioneWalletId], references: [id])

  /// AF-AC: flag di sospetta collusione rilevati al momento dell'accredit.
  /// CSV di codici (es. "SAME_IBAN,SAME_IP_SIGNUP"). Se valorizzato,
  /// stato è DA_REVISIONARE finché un admin non sblocca.
  flagsDetected String?

  /// AF-AC: review admin (popolato quando passa a ACCREDITATA o ANNULLATA
  /// dopo flag DA_REVISIONARE).
  reviewedAt   DateTime?
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("CommissioneAffiliazioneReviewer", fields: [reviewedById], references: [id])
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([praticaId])
  @@index([referenteId, stato])
  @@index([stato])
  @@map("commissioni_affiliazione")
}

// ============================================================
// MODELS — valutazioni
// ============================================================

model Valutazione {
  id String @id @default(uuid()) @db.Uuid

  praticaId String  @unique @db.Uuid
  pratica   Pratica @relation(fields: [praticaId], references: [id], onDelete: Cascade)

  agenziaId String  @db.Uuid
  agenzia   Company @relation("ValutazioniAgenzia", fields: [agenziaId], references: [id])

  dealerId String  @db.Uuid
  dealer   Company @relation("ValutazioniDealer", fields: [dealerId], references: [id])

  // Multi-sede: sede valutata / sede broker che vota.
  agenziaSedeId String? @db.Uuid
  agenziaSede   Sede?   @relation("ValutazioniAgenziaSede", fields: [agenziaSedeId], references: [id])
  brokerSedeId  String? @db.Uuid
  brokerSede    Sede?   @relation("ValutazioniBrokerSede", fields: [brokerSedeId], references: [id])

  stelle Int // 1..5
  note   String?

  createdAt DateTime @default(now())

  @@index([agenziaId])
  @@map("valutazioni")
}

// ============================================================
// MODELS — fatturazione (FT-A)
// ============================================================

enum RegimeFiscale {
  ORDINARIO
  FORFETTARIO
  PRIVATO
}

enum DocumentoFiscaleTipo {
  FATTURA_PV
  DOC_BROKER
  PENALE_BROKER
  NOTA_VARIAZIONE
}

enum FatturaPaTipo {
  TD01
  TD06
  TD04
  TD05
}

enum DocumentoFiscaleStatoPagamento {
  IN_ATTESA
  PAGATA
  SCADUTA
  STORNATA
}

model DocumentoFiscale {
  id String @id @default(uuid()) @db.Uuid

  tipo          DocumentoFiscaleTipo
  fatturaPaTipo FatturaPaTipo?

  // Riferimenti: FATTURA_PV → pratica; DOC_BROKER → payout; NOTA_VARIAZIONE → originale
  praticaId String?  @db.Uuid
  pratica   Pratica? @relation(fields: [praticaId], references: [id])
  payoutId  String?  @unique @db.Uuid
  payout    Payout?  @relation(fields: [payoutId], references: [id])

  emittenteCompanyId String?  @db.Uuid
  emittenteCompany   Company? @relation("DocumentiEmessi", fields: [emittenteCompanyId], references: [id])
  // Nullable: PV non è una Company (per i DOC_BROKER il destinatario è PV) → si
  // usa lo snapshot `datiDestinatario`. Per FATTURA_PV è valorizzato (agenzia).
  destinatarioCompanyId String?  @db.Uuid
  destinatarioCompany   Company? @relation("DocumentiRicevuti", fields: [destinatarioCompanyId], references: [id])

  // Snapshot immutabili dei dati fiscali al momento dell'emissione.
  datiEmittente    Json
  datiDestinatario Json

  numeroProgressivo Int
  anno              Int
  // Stringa formattata congelata all'emissione (immutabile): es. "PV-0047-2026-00001".
  numeroDocumentoStr String? @unique

  importoLordoCent    Int // negativo per NOTA_VARIAZIONE (TD04)
  imponibileCent      Int?
  ivaCent             Int?
  aliquotaIvaPct      Int?
  ritenutaAccontoCent Int?

  statoPagamento DocumentoFiscaleStatoPagamento @default(IN_ATTESA)
  trasmessoSdiAt DateTime?
  trasmessoSdiBy String?  @db.Uuid

  pdfStorageKey String?
  xmlStorageKey String?
  pdfHash       String?

  feeAddebitoId       String? @db.Uuid
  transazioneWalletId String? @unique @db.Uuid

  notaVariazionePerId  String?            @db.Uuid
  notaVariazionePer    DocumentoFiscale?  @relation("NoteVariazione", fields: [notaVariazionePerId], references: [id])
  notaVariazioneFiglie DocumentoFiscale[] @relation("NoteVariazione")

  emessoAt       DateTime  @default(now())
  inviatoEmailAt DateTime?

  @@unique([emittenteCompanyId, anno, numeroProgressivo, tipo])
  @@index([praticaId])
  @@index([payoutId])
  @@index([destinatarioCompanyId, statoPagamento])
  @@index([emittenteCompanyId, anno])
  @@index([emessoAt])
  @@map("documenti_fiscali")
}

// ============================================================
// MODELS — listini / osservatorio prezzi
// ============================================================

model Listino {
  id String @id @default(uuid()) @db.Uuid

  agenziaId String  @db.Uuid
  agenzia   Company @relation(fields: [agenziaId], references: [id], onDelete: Cascade)

  // Multi-sede: listino per sede fisica.
  sedeId String? @db.Uuid
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  formato ListinoFormato

  // Se formato = UPLOAD_FILE, riferimento al documento (non FK hard: può vivere in storage esterno)
  documentoStorageKey String?

  // Se formato = FORM_STRUTTURATO: campi in centesimi
  prezzoBaseTrapassoCent Int?
  prezzoMinivolturaCent  Int?
  maggiorazioni          Json? // struttura libera (es. { "pre2015": 3000, "lottoMassivo": -500 })

  provincieCopertura String[] // es. ["VE", "PD", "TV"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agenziaId])
  @@map("listini")
}

/// Listino fee di piattaforma (costo agenzia + commissione broker + costo
/// affiliazione, per tipo). Append-only versionato: esattamente una riga
/// `attivo=true` è il listino corrente. Il ricavo lordo PV è derivato
/// (fee − commissione), NON persistito.
model TariffaPiattaforma {
  id String @id @default(uuid()) @db.Uuid

  // SEMPLICE — per veicolo, in centesimi
  sempliceFeeAgenziaCent    Int
  sempliceCreditoBrokerCent Int
  sempliceAffiliazioneCent  Int

  // MINIVOLTURA — per veicolo, in centesimi
  minivolturaFeeAgenziaCent    Int
  minivolturaCreditoBrokerCent Int
  minivolturaAffiliazioneCent  Int

  attivo Boolean @default(false) // invariante applicativo: esattamente una riga true
  note   String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdBy   User?    @relation("TariffaCreatedBy", fields: [createdById], references: [id])

  @@index([attivo])
  @@index([createdAt])
  @@map("tariffe_piattaforma")
}

// ============================================================
// MODELS — notifiche (audit)
// ============================================================

model NotificaInviata {
  id String @id @default(uuid()) @db.Uuid

  tipo   NotificaTipo
  canale NotificaCanale
  stato  NotificaStato  @default(SCHEDULED)

  // Destinatario: può essere user+company, solo company, o libero
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Multi-sede: sede destinataria/contesto della notifica (opzionale).
  sedeId String? @db.Uuid
  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: SetNull)

  destinazione String // email o telefono effettivo al momento dell'invio
  subject      String?
  bodyPreview  String? // primi 200 char (audit rapido)
  payload      Json // dati usati per generare la notifica

  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  failedAt    DateTime?
  readAt      DateTime?

  providerRef  String? // message-id del provider (Resend/Twilio/...)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([tipo])
  @@index([userId])
  @@index([companyId])
  @@index([stato, scheduledAt])
  @@map("notifiche_inviate")
}

/// Evento in-app di una pratica, mostrato come modale istantanea alla CONTROPARTE
/// (broker <-> agenzia). Feed separato dal log email `NotificaInviata`. Riferimenti
/// soft (scalari, niente FK) per restare una tabella isolata: `praticaId` può
/// puntare a una pratica eliminata, `targetCompanyId` è l'azienda che deve vedere
/// la modale. `tipo` è una costante app-level (lib/eventi/tipi.ts) — niente enum.
model EventoPratica {
  id String @id @default(uuid()) @db.Uuid

  praticaId       String? @db.Uuid
  targetCompanyId String  @db.Uuid

  // Multi-sede: sede destinataria della modale evento (controparte operativa).
  targetSedeId String? @db.Uuid
  targetSede   Sede?   @relation(fields: [targetSedeId], references: [id])

  tipo     String
  titolo   String
  testo    String
  ctaLabel String?
  ctaHref  String?

  seenAt       DateTime?
  seenByUserId String?   @db.Uuid

  createdAt DateTime @default(now())

  @@index([targetCompanyId, seenAt])
  @@index([praticaId])
  @@map("eventi_pratica")
}

// ============================================================
// ENUMS — CRM (release CRM-A 2026-05-06)
// Spec: docs/crm-spec-implementativa.md
// ============================================================

enum CrmContactCategoria {
  BROKER
  AGENZIA
}

enum CrmStatoContatto {
  S0 // Non contattato
  S1 // Non risponde
  S2 // Non interessato
  S3 // Interessato
  S4 // Link non aperto
  S5 // Link aperto, non iscritto
  S6 // Iscrizione incompleta
  S7 // Iscritto, non attivo
  S8 // Prima pratica
  S9 // Attivo ricorrente
  S10 // Churned
}

enum CrmFonteAcquisizione {
  CSV_INIZIALE
  ISCRIZIONE_DIRETTA
  REFERRAL
  ALTRO
}

enum CrmCallEsito {
  NON_RISPONDE
  NON_INTERESSATO
  INTERESSATO
  RICHIAMA
  ISCRITTO
}

enum CrmSentiment {
  POSITIVO
  NEUTRO
  NEGATIVO
}

enum CrmPlatStatus {
  ATTIVO
  INATTIVO
  SOSPESO
}

enum CrmAgentLingua {
  ITALIANO
  ENGLISH
  ESPANOL
}

enum CrmAgentVoce {
  FEMMINILE_NATURALE
  MASCHILE_NATURALE
  CLONATA
}

enum CrmAgentAccento {
  NEUTRO_ITALIANO
  NORD_ITALIA
  CENTRO_ITALIA
  SUD_ITALIA
}

enum CrmCampaignGiorni {
  LUN_VEN
  LUN_SAB
  TUTTI
}

enum CrmCampaignStato {
  ATTIVA
  PAUSATA
  CHIUSA
}

enum CrmChatbotCanale {
  SITO
  WHATSAPP
  MAIL
  TUTTI
}

// ============================================================
// MODELS — CRM (release CRM-A 2026-05-06)
// ============================================================

/// Contatto della pipeline lead pre-iscrizione. Vive separato da Company
/// (utenti/aziende che si sono iscritti); il match avviene via webhook a
/// iscrizione completata (cascata email → tel → P.IVA). Spec §2.1.
model CrmContact {
  id String @id @default(uuid()) @db.Uuid

  nome      String
  cat       CrmContactCategoria
  tel       String // sempre presente per decisione 11
  wa        String?
  email     String?
  piva      String?
  indirizzo String?
  citta     String?
  cap       String?
  regione   String?

  status        CrmStatoContatto     @default(S0)
  fonte         CrmFonteAcquisizione
  assignedToId  String?              @db.Uuid
  assignedTo    User?                @relation("CrmContactAssigned", fields: [assignedToId], references: [id])
  lastContactAt DateTime?
  nextContactAt DateTime?

  // Aggregati chiamate (denormalizzati da CrmCall via trigger applicativo)
  callCount    Int           @default(0)
  callEsito    CrmCallEsito?
  sentiment    CrmSentiment?
  obiezioni    String? // CSV tag
  noteAI       String?
  trascrizione String?
  noteManuali  String?

  // Pixel/funnel tracking
  linkInviato    Boolean   @default(false)
  linkInviatoAt  DateTime?
  linkAperto     Boolean   @default(false)
  linkAperture   Int       @default(0)
  videoInviato   Boolean   @default(false)
  videoMin       Int       @default(0)
  mailAperta     Boolean   @default(false)
  smsInviato     Boolean   @default(false)
  waInviato      Boolean   @default(false)
  iscrizioneInit Boolean   @default(false)
  iscrizioneComp Boolean   @default(false)
  iscrizioneAt   DateTime?

  // Match con Company piattaforma (post-iscrizione, via webhook)
  companyId      String?        @db.Uuid
  company        Company?       @relation("CrmContactCompany", fields: [companyId], references: [id], onDelete: SetNull)
  platStatus     CrmPlatStatus?
  primaPratica   Boolean        @default(false)
  primaPraticaAt DateTime?
  praticheTotal  Int            @default(0)
  praticheMonth  Int            @default(0)
  lastAccessAt   DateTime?
  tassoComp      Int            @default(0) // 0-100

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campaignAssegnazioni CrmCampaignAssegnazione[]
  calls                CrmCall[]

  @@index([cat])
  @@index([status])
  @@index([regione])
  @@index([assignedToId])
  @@index([companyId])
  @@index([linkAperto])
  @@map("crm_contacts")
}

/// Configurazione del bot vocale Vapi (FASE CRM-H per integrazione reale).
model CrmSalesAgent {
  id      String          @id @default(uuid()) @db.Uuid
  nome    String
  lingua  CrmAgentLingua  @default(ITALIANO)
  voce    CrmAgentVoce    @default(FEMMINILE_NATURALE)
  accento CrmAgentAccento @default(NEUTRO_ITALIANO)

  prompt         String
  scriptPrimo    String
  scriptFollowup String
  qa             String
  postCall       String

  vapiAgentId String? // popolato in CRM-H

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campaigns CrmCampaign[]
  calls     CrmCall[]

  @@map("crm_sales_agents")
}

/// Campagna di chiamate AI con filtri target e parametri esecuzione.
/// Owner = chi l'ha creata, gestione esclusiva propria + admin/AD/CTO.
model CrmCampaign {
  id   String @id @default(uuid()) @db.Uuid
  nome String

  agentId String        @db.Uuid
  agent   CrmSalesAgent @relation(fields: [agentId], references: [id])

  ownerId String @db.Uuid
  owner   User   @relation("CrmCampaignOwner", fields: [ownerId], references: [id])

  regione     String?
  cat         CrmContactCategoria?
  statoTarget CrmStatoContatto?

  maxTry       Int               @default(3)
  intervalMin  Int               @default(60)
  oraStart     String            @default("09:00")
  oraEnd       String            @default("18:00")
  giorniAttivi CrmCampaignGiorni @default(LUN_VEN)

  status CrmCampaignStato @default(ATTIVA)
  note   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assegnazioni CrmCampaignAssegnazione[]
  calls        CrmCall[]

  @@index([agentId])
  @@index([ownerId])
  @@index([status])
  @@map("crm_campaigns")
}

model CrmCampaignAssegnazione {
  id         String      @id @default(uuid()) @db.Uuid
  campaignId String      @db.Uuid
  contactId  String      @db.Uuid
  campaign   CrmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    CrmContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  tentativi        Int           @default(0)
  esitoUltimo      CrmCallEsito?
  ultimaChiamataAt DateTime?
  createdAt        DateTime      @default(now())

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@map("crm_campaign_assegnazioni")
}

/// Storico chiamate per contatto. Ogni call Vapi (CRM-H) genera una row;
/// gli aggregati su CrmContact sono denormalizzati per query veloce.
model CrmCall {
  id String @id @default(uuid()) @db.Uuid

  contactId String     @db.Uuid
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  campaignId String?      @db.Uuid
  campaign   CrmCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  agentId String?        @db.Uuid
  agent   CrmSalesAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  startedAt DateTime
  endedAt   DateTime?
  duration  Int? // secondi
  esito     CrmCallEsito?
  sentiment CrmSentiment?

  summary       String?
  transcript    String?
  obiezioniTags String?

  // Integrazione esterna (CRM-H)
  vapiCallId   String? @unique
  recordingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([campaignId])
  @@index([startedAt])
  @@map("crm_calls")
}

/// Configurazione bot testuale per sito/WhatsApp/Mail.
model CrmChatbot {
  id   String @id @default(uuid()) @db.Uuid
  nome String

  target    CrmContactCategoria?
  canale    CrmChatbotCanale
  posizione String?
  attivo    Boolean              @default(true)

  prompt     String
  obiettivo  String
  qa         String
  escalation String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("crm_chatbots")
}

// ============================================================
// CODICI PROMOZIONALI
// ============================================================

model PromoCode {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  amountCent     Int
  expiresAt      DateTime?
  maxRedemptions Int?
  active         Boolean   @default(true)
  createdById    String?   @db.Uuid

  redemptions PromoCodeRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promo_codes")
}

model PromoCodeRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  promoCodeId String    @db.Uuid
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  companyId   String    @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  amountCent          Int
  transazioneWalletId String? @db.Uuid

  createdAt DateTime @default(now())

  @@unique([promoCodeId, companyId])
  @@index([promoCodeId])
  @@map("promo_code_redemptions")
}

model AtecoAllowedCode {
  id          String      @id @default(uuid()) @db.Uuid
  companyType CompanyType
  code        String // normalizzato senza punti, es. "4511"
  label       String?
  active      Boolean     @default(true)
  createdById String?     @db.Uuid
  createdAt   DateTime    @default(now())

  @@unique([companyType, code])
  @@map("ateco_allowed_codes")
}

/// Contatori rate-limit del chatbot (Vercel serverless → store su DB).
/// key es. "ipmin:<ip>:<minuto>", "ipday:<ip>:<giorno>", "global:<giorno>".
model ChatbotRateBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@map("chatbot_rate_buckets")
}

/// Metriche aggregate del chatbot + domande senza risposta (per migliorare i docs).
/// Niente PII deliberata, niente trascrizioni complete. Retention ~90 giorni.
model ChatbotInteraction {
  id                 String   @id @default(uuid()) @db.Uuid
  createdAt          DateTime @default(now())
  tier               String
  answered           Boolean
  escalated          Boolean
  unansweredQuestion String?

  @@map("chatbot_interactions")
}

// ============================================================
// ENUMS + MODEL — numerazione fiscale paper (FT-B)
// Spec: docs/PassaggioVeloce NumerazioneFatture.docx
// ============================================================

enum ContatoreFiscaleTipo {
  FATTURA_PV
  DOC_BROKER
  NOTA_CREDITO
  PENALE
}

// Contatore di numerazione fiscale (paper NumerazioneFatture). Una riga per
// (soggetto emittente, tipo documento, anno fiscale). idSoggetto = "PV" per i
// documenti propri di Passaggio Veloce, oppure Company.id del broker per i
// documenti conto terzi. Incremento atomico via INSERT … ON CONFLICT.
model ContatoreFiscale {
  id            String               @id @default(uuid()) @db.Uuid
  idSoggetto    String
  tipoDocumento ContatoreFiscaleTipo
  anno          Int
  contatore     Int                  @default(0)
  aggiornatoAt  DateTime             @updatedAt

  @@unique([idSoggetto, tipoDocumento, anno])
  @@map("contatori_fiscali")
}
