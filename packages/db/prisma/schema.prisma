// Passaggio Veloce - Prisma schema
// Schema esteso Fase 2.5: auth + core business models (pratiche, documenti,
// distribuzione, wallet, fee, valutazioni, listini, notifiche).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS — identità e accesso
// ============================================================

enum CompanyType {
  DEALER
  AGENZIA
}

enum UserRole {
  ADMIN_AZIENDA
  UTENTE_AZIENDA
  ADMIN_PIATTAFORMA
  ASSISTENTE
  // CRM team interno PV (release CRM-A 2026-05-06).
  // ADMIN_PIATTAFORMA mappa con `admin` del prototipo CRM (vedi
  // docs/crm-spec-implementativa.md). I 5 ruoli sotto sono esclusivi
  // del modulo CRM e non hanno accesso ai pannelli operativi piattaforma.
  AD
  CTO
  CFO
  SALES_MANAGER
  SALES
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Multi-sede: ruolo di un utente DENTRO una sede (membership UserSede).
// Il proprietario (User.role = ADMIN_AZIENDA) ha accesso implicito a tutte
// le sedi della madre e non richiede righe UserSede.
enum RuoloSede {
  ADMIN_SEDE
  OPERATORE
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ============================================================
// ENUMS — pratiche
// ============================================================

enum PraticaTipo {
  SEMPLICE
  MINIVOLTURA
}

enum PraticaStato {
  BOZZA
  IN_ATTESA_ROUND_1
  IN_ATTESA_ROUND_2
  IN_ATTESA_ROUND_3
  IN_ESCALATION
  ACCETTATA
  PROCESSATA
  FIRMATA
  SCADUTA
  ANNULLATA
}

enum AssegnazioneEsito {
  PENDING
  ACCETTATA
  RIFIUTATA
  TIMEOUT
  ASSEGNATA_ALTRO
}

// ============================================================
// ENUMS — documenti e gating IA
// ============================================================

enum DocumentoTipo {
  LIBRETTO_CIRCOLAZIONE
  CI_FRONTE
  CI_RETRO
  CODICE_FISCALE
  CODICE_FISCALE_RETRO
  PROCURA
  PERMESSO_SOGGIORNO
  VISURA_CAMERALE
  CERTIFICATO_PROPRIETA
  // Schema Documentale v7 (SD-A release 2026-05)
  REVOCA_COMODATO
  CERTIFICATO_MORTE
  ATTO_ACCETTAZIONE_EREDITA
  DICHIARAZIONE_QUALITA_EREDE
  AUTORIZZAZIONE_TUTORE
  ALTRO
  PASSAPORTO
  PATENTE
  PATENTE_RETRO
  LIBRETTO_CIRCOLAZIONE_RETRO
  // Foglio complementare (subentra al libretto, tipicamente quando vende un
  // commerciante d'auto): un solo PDF, mappatura campi dedicata.
  FOGLIO_COMPLEMENTARE
  // Delega/procura a vendere (allegati pratica, no engine/gating)
  DELEGA_VENDITA
  DOCUMENTO_DELEGATO
}

// Tipo di documento di circolazione del veicolo: il libretto standard (fronte+
// retro) oppure il foglio complementare (un solo PDF).
enum TipoDocumentoVeicolo {
  LIBRETTO
  FOGLIO_COMPLEMENTARE
}

// Schema Documentale v7: tipologia di soggetto (venditore o acquirente).
// Determina insieme di documenti richiesti nell'albero decisionale.
enum TipoSoggetto {
  PRIVATO_ITALIANO // Persona fisica italiana (variante CI cartacea/elettronica in CiTipo)
  STRANIERO_EXTRA_UE
  AZIENDA
  OPERATORE_AUTO // Solo lato venditore: dealer/commerciante (mini voltura)
}

// Variante della carta d'identità (rilevante solo per il privato con CI): la CIE
// elettronica contiene già il codice fiscale, la cartacea no. Determina se serve
// il documento tessera sanitaria / codice fiscale separato.
enum CiTipo {
  CARTACEA
  ELETTRONICA
}

// Schema Documentale v7: motivo per cui una pratica entra in revisione manuale
// del team PV (caso non riconosciuto dall'engine documentale).
enum MotivoRevisioneManuale {
  DOCUMENTO_NON_STANDARD
  CASO_NON_PREVISTO_DA_SCHEMA
  RICHIESTA_BROKER
}

enum DocumentoOwner {
  VENDITORE
  ACQUIRENTE
  AMMINISTRATORE
  AZIENDA
}

enum OcrStato {
  NONE
  PENDING
  SUCCESS
  FAILED
}

enum GatingStato {
  NONE
  PENDING
  PASSED
  FAILED
  OVERRIDDEN
}

// ============================================================
// ENUMS — calendario
// ============================================================

